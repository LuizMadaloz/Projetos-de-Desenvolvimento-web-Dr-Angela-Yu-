<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="main.css">
</head>
<body>
    <div class="principal">
    <%- include("partials/header.ejs") %>
<h1>Postagens</h1>
<div class="postados">
<% if(locals.postagem){ %>
<% postagem.forEach(post => { %>
    <div class="post">
        <h2><%= post.titulo %></h2>
        <p><%= post.conteudo %></p>
        <small><%= post.data %></small>

        <!-- Formulário para apagar o post -->
        <form action="/deletarPost" method="POST" style="margin-top: 10px;">
            <!-- Campo escondido que armazena o ID deste post específico -->
            <input type="hidden" name="id" value="<%= post.id %>">
            <button type="submit" class="btn-deletar">Apagar Post</button>
        </form>
    </div>
<% }) %>
        
   <% }else{ %>
    <h2>
     sem postagens
    </h2>

    </div>
    <% }; %>

    
    
   
    

<%- include("partials/footer.ejs") %>
</div>
    
</body>
</html>
