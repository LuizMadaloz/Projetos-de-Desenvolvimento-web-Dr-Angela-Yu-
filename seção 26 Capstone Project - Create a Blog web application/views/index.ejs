<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="main.css">
</head>
<body>
    <%- include("partials/header.ejs") %>
<h1>Postagens</h1>
<% if(locals.postagem){ %>
   <%   postagem.forEach(posts => { %>
        <h2>
        <%= posts.titulo %>    
        </h2>
        <p>
        <%= posts.conteudo %>
            </p>
            <p>
        <%= posts.data %>
        </p>

        <% }); %>
        
   <% }else{ %>
    <h2>
     sem postagens
    </h2>
    <% }; %>

    
    
   
    

<%- include("partials/footer.ejs") %>
    
</body>
</html>
