<%- include("partials/header.ejs") %>
<h1>Postagens</h1>
<% if(locals.postagem){ %>
   <%   postagem.forEach(posts => { %>
        <h2>
        <%= posts.titulo %>    
        </h2>
        <p>
        <%= posts.conteudo %>
            </p>
            <p>
        <%= posts.data %>
        </p>

        <% }); %>
        
   <% }else{ %>
    <h2>
     sem postagens
    </h2>
    <% }; %>

    
    
   
    

