<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="main.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">

</head>
<body>
    <div class="principal overflow-hidden">
    <%- include("partials/header.ejs") %>
    

<div class=" container text-center">
    <h1 class="my-4">Postagens</h1>

        
<div class="row justify-content-center">
<% if(locals.postagem){ %>
<% postagem.forEach(post => { %>
        <div class="md:col-4 col-12 posters">
        <div class="card card-post p-3 h-100"> 
        <h2><%= post.titulo %></h2>
        <p><%= post.conteudo %></p>
        <small><%= post.data %></small>

        
        <form action="/deletarPost" method="POST" style="margin-top: 10px;">
            <input type="hidden" name="id" value="<%= post.id %>">
            <button type="submit" class="btn-deletar">Apagar Post</button>
        </form>
        </div>
        </div>

    
<% }) %>
        
   <% }else{ %>
    <h2>
     sem postagens
    </h2>

    
    <% }; %>
    </div>
    
    

    
    
   
 </div>

<%- include("partials/footer.ejs") %>



</div>
    
</body>
</html>
