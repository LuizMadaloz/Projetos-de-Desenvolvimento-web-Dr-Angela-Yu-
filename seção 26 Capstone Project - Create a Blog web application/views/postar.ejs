<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="main.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">

</head>
<body>
    <%- include("partials/header.ejs") %>
<div class="container text-center md:container">
    
        
<form action="envioPost" method="POST">
    <div class="row"></div>
    <div class="col-12 md:col-6 text-center"></div>
<label for="titulo">Titulo</label>
<br>
<input type="text" id="titulo" name="titulo">
<br>

</div>

<div class="row justify-content-center">
    <div class="md:col-8 col-12 text-center">
        <label for="blogText">Escreva seu texto</label>
        <br>
<textarea name="blogText" id="blogText" rows="40" cols="100"></textarea>
</div>
<button type="submit">Enviar</button>
</div>

</form>

</div>

<%- include("partials/footer.ejs") %>
    
</body>
</html>
