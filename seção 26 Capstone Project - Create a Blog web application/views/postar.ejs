<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="main.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">

</head>
<body>
    <div class="principal">
    <%- include("partials/header.ejs") %>
<div class="container text-center md:container">
    
        
<form action="envioPost" method="POST">
    <div class="row"></div>
    <div class="col-12 md:col-6 text-center"></div>
     <% if (locals.post) { %>
        <input type="hidden" name="id" value="<%= post.id %>">
    <% } %>
<label for="titulo">Titulo</label>
<br>
<input type="text" id="titulo" name="titulo" <% if (locals.post){ %> value= "<%= post.titulo %>" <% }; %>>
<br>

</div>

<div class="row justify-content-center">
    <div class="md:col-8 col-12 text-center">
        <label for="blogText">Escreva seu texto</label>
        <br>
<textarea name="blogText" id="blogText" rows="15" cols="100" maxlength="1000"><% if(locals.post){ %><%= post.conteudo %> <% }; %></textarea>
</div>
<br>
<div class="row justify-content-center">

<button type="submit" class="botao">Enviar</button>

</div>
</div>

</form>

</div>

<%- include("partials/footer.ejs") %>
</div>
    
</body>
</html>

